<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} [%-5level] [%-7.7thread] [%-40.40logger{39}] - %msg method=%X{method}, path=%X{path}, requestId=%X{requestId}%n
            </pattern>
        </encoder>
    </appender>

    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>http://localhost:3100/loki/api/v1/push</url>
            <connectionTimeoutMs>3000</connectionTimeoutMs>
        </http>

        <format>
            <label>
                <pattern>app=play-ground,env=local,level=%level,logger=%logger{20}</pattern>
            </label>

            <message class="net.logstash.logback.layout.LogstashLayout">
                <includeMdc>true</includeMdc>
                <customFields>{"app":"play-ground"}</customFields>
            </message>
        </format>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="LOKI"/>
    </root>

</configuration>
