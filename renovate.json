{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "gradle",
    "gradle-wrapper"
  ],
  "packageRules": [
    {
      "description": "Automerge all patch updates for low-risk libs",
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": false,
      "platformAutomerge": false,
      "schedule": [
        "at any time"
      ],
      "matchPackageNames": [
        "/com.fasterxml.jackson.module:jackson-module-kotlin/",
        "/^org\\.jetbrains\\.kotlin/"
      ]
    }
  ],
  "reviewers": [
    "SLCube"
  ]
}
