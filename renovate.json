{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "gradle",
    "gradle-wrapper"
  ],
  "packageRules": [
    {
      "description": "Group all version catalog updates together",
      "matchFileNames": [
        "gradle/libs.versions.toml"
      ],
      "groupName": "Version Catalog Dependencies"
    }
  ],
  "reviewers": [
    "SLCube"
  ]
}